# Copier ce fichier en .env et remplir avec de vraies valeurs.
# Ne JAMAIS commiter le fichier .env (deja ignore via .gitignore).

# Reseau Docker dedie Gitea/Woodpecker
CI_NET_SUBNET=172.16.0.0/24
CI_NET_GATEWAY=172.16.0.1

# Domaines internes (resolus cote client via le fichier hosts -> IP VPN du homelab)
GITEA_DOMAIN=gitea.homelab.internal
WOODPECKER_DOMAIN=woodpecker.homelab.internal

# Username Gitea qui doit avoir les droits admin sur Woodpecker
WOODPECKER_ADMIN_USER=changeme_votre_username_gitea

# Postgres (base mutualisee native du homelab)
GITEA_DB_PASS=changeme_openssl_rand_base64_24
WOODPECKER_DB_PASS=changeme_openssl_rand_hex_24

# Secret partage gRPC serveur <-> agent Woodpecker
# Utilise comme WOODPECKER_GRPC_SECRET cote serveur, WOODPECKER_AGENT_SECRET cote agent
# Generer avec: openssl rand -hex 32
WOODPECKER_AGENT_SECRET=changeme_openssl_rand_hex_32

# OAuth2 app Gitea "Woodpecker CI"
# A creer dans Gitea: Parametres du site > Applications > Applications OAuth2 gerees
# Redirect URL: http://<WOODPECKER_DOMAIN>:8000/authorize
WOODPECKER_GITEA_CLIENT=changeme_client_id
WOODPECKER_GITEA_SECRET=changeme_client_secret
