# Copier ce fichier en .env et remplir avec de vraies valeurs.
# Ne JAMAIS commiter le fichier .env (deja ignore via .gitignore).

# Reseau Docker dedie Gitea/Woodpecker
CI_NET_SUBNET=172.16.0.0/24
CI_NET_GATEWAY=172.16.0.1

# Mailpit mutualisé (projet mailpit/) : IP Tailscale de l'hôte, port 1025 (voir mailpit/README.md).
# Le sous-réseau CI_NET_SUBNET doit être autorisé par le pare-feu vers <SMTP_HOST>:1025.
SMTP_HOST=100.x.y.z

# Domaines internes (resolus cote client via le fichier hosts -> IP VPN du homelab)
GITEA_DOMAIN=gitea.homelab.internal
WOODPECKER_DOMAIN=woodpecker.homelab.internal

# Username Gitea qui doit avoir les droits admin sur Woodpecker
WOODPECKER_ADMIN_USER=changeme_votre_username_gitea

# Les secrets suivants ne vivent plus ici : ils sont geres dans Infisical
# (projet "Shared Keys", environnement prod) et injectes automatiquement
# au deploiement via deploy.sh. Voir README.md.
#   - GITEA_DB_PASS
#   - WOODPECKER_DB_PASS
#   - WOODPECKER_AGENT_SECRET (= WOODPECKER_GRPC_SECRET cote serveur)
#   - WOODPECKER_GITEA_CLIENT
#   - WOODPECKER_GITEA_SECRET
