# Copier ce fichier en .infisical-identity.env (jamais commite, voir .gitignore).
# Identifiants de la Machine Identity "woodpecker-ci-deploy" creee dans Infisical
# (Shared Keys > Access Control > Machine Identities).
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=changeme
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=changeme
# URL de l'API Infisical (adresse Tailscale du homelab).
INFISICAL_API_URL=http://caesura.<tailnet>.ts.net:8090/api
